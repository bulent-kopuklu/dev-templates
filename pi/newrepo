#!/usr/bin/env bash
# Creates a bare, group-shared git repo on the git server (runs there).
#   newrepo <name>          -> /mnt/storage/workspace/git-repos/<name>.git
# Runs as dietpi (passwordless sudo) and creates the repo as the git user.
set -euo pipefail
root="${GIT_ROOT:-/mnt/storage/workspace/git-repos}"
name="${1:?usage: newrepo <name>}"
name="${name%.git}"
repo="$root/$name.git"
[ -e "$repo" ] && { echo "exists: $repo" >&2; exit 1; }
# the repo must be owned by the git user, or clients connecting as git hit "dubious ownership"
if [ "$(id -un)" = git ]; then git init -q --bare --shared=group "$repo"
else sudo -n -u git git init -q --bare --shared=group "$repo"; fi
echo "$repo"
